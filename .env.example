# Optional production integrations
RESEND_API_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_CALENDAR_URL=

# Design tech stack — Figma MCP (see docs/design-stack.md)
# Personal access token from https://www.figma.com/developers/api#access-tokens
# Read-only "file content" + "dev resources" scopes are enough.
FIGMA_API_KEY=

# Scope Studio — inhouse "URL → premium site → GitHub → Vercel" tool (docs/studio.md).
# The AI engine uses your local Claude Code login (Claude subscription) — no API key here.
# GitHub PAT with repo creation + contents (classic "repo", or fine-grained: Administration +
# Contents = read/write). Needed to create the client repo and push the generated site.
GITHUB_TOKEN=
# Vercel token from https://vercel.com/account/tokens — used to trigger the deployment.
VERCEL_TOKEN=
# Only if the Vercel project lives under a team (not your personal account).
VERCEL_TEAM_ID=
# Optional: pin the design agent's model (defaults to your Claude Code default).
STUDIO_MODEL=
